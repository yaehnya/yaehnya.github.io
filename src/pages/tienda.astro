---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Tienda" page="tienda">
  <main class="page">
    <h1 class="wordmark"><span class="wm">Tienda</span><small>{site.name}</small></h1>
    <ul class="products">
      {site.products.map(p => (
        <li>
          <a href={p.href} target="_blank" rel="noopener">
            <img src={p.image} alt={p.name} width="1000" height="1000" loading="lazy" />
            <span class="name stretch">{p.name}</span>
            <span class="label price">{p.price}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="all label"><a href={site.shop} target="_blank" rel="noopener">Ver toda la tienda ↗</a></p>
  </main>
</Base>

<style>
  .products {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 48px 24px;
    max-width: 1100px; margin: 0 auto; padding: 0; list-style: none;
  }
  .products a { display: grid; gap: 8px; justify-items: center; text-align: center; }
  .products img { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--panel); margin-bottom: 8px; filter: grayscale(1); }
  .name { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; }
  .price { color: var(--muted); }
  .products a:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .all { margin-top: 64px; text-align: center; }

  /* Each product turns to face you as it comes up, as a cover does in the middle of Cover Flow. */
  @keyframes turn-in { from { transform: perspective(900px) rotateY(-55deg) translateZ(-60px); opacity: 0; } }
  @supports ((animation-timeline: view()) and (animation-range: entry)) {
    @media (prefers-reduced-motion: no-preference) {
      .products li { animation: turn-in linear both; }
      .products > li { animation-timeline: view(); animation-range: entry 0% entry 85%; }
    }
  }
  .all a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
