---
// Tienda, as iOS 4's App Store: the blue bar, a banner of what's featured that slides by itself and
// under your finger, the segments (Todo · Ropa · Música), and each product as an app in the list with
// its price button. A tap on the price turns it into the green "COMPRAR", as on the iPhone; a second tap
// goes to the product in the shop.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const products = site.products;
const segments = [['todo', 'Todo'], ['ropa', 'Ropa'], ['musica', 'Música']] as const;
---

<Base title="Tienda" page="tienda" description={`La tienda de ${site.name}: ropa y discos.`}>
  <main class="page store">
    <h1 class="wordmark"><span class="wm">Tienda</span><small>{site.name}</small></h1>

    <section class="appstore" aria-label={`Tienda de ${site.name}`}>
      <header class="as-nav"><b>Destacados</b></header>

      <div class="banner">
        <ul class="slides" data-lenis-prevent>
          {products.map((p, i) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener" aria-label={`${p.name}, ${p.price}`}>
                <img src={p.image} alt="" width="1000" height="1000" loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
                <span class="cap"><b>{p.name}</b><span>{p.price}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="dots" aria-hidden="true">{products.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</p>
      </div>

      <div class="bar">
        <div class="segmented" role="radiogroup" aria-label="Mostrar">
          {segments.map(([id, label], i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-seg={id}>{label}</button>
          ))}
        </div>
      </div>

      <ol class="rows">
        {products.map((p, i) => (
          <li data-kind={p.kind} style={`--i: ${i}`}>
            <span class="ic"><img src={p.image} alt="" width="120" height="120" loading="lazy" /></span>
            <span class="info">
              <b>{p.name}</b>
              <span>{site.name.charAt(0) + site.name.slice(1).toLowerCase()}{p.detail && ` · ${p.detail}`}</span>
            </span>
            <a class="price" href={p.href} target="_blank" rel="noopener" data-price={p.price} aria-label={`${p.name}: ${p.price}`}>
              <span>{p.price}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="all"><a href={site.shop} target="_blank" rel="noopener">Ver toda la tienda ›</a></p>
    </section>
  </main>
</Base>

<style>
  .store { display: grid; justify-items: center; align-content: start; }
  .page > .wordmark { margin-bottom: 48px; }

  /* The App Store's screen: a phone-wide column in the case's beige, like Contacto's Messages. */
  .appstore {
    width: min(460px, 100%); overflow: hidden; border-radius: 22px; background: #fff; color: #000;
    box-shadow: 0 0 0 10px #f4f2ee, 0 0 0 11px #e2ddd2, 0 30px 60px rgba(70, 52, 30, .18);
    font: 15px/1.3 'Helvetica Neue', Helvetica, Arial, sans-serif; text-transform: none; letter-spacing: 0;
  }
  .as-nav {
    display: grid; place-items: center; height: 44px; border-bottom: 1px solid #2d3642; color: #fff;
    background: linear-gradient(#b0bccd, #889bb3 50%, #8195af 51%, #6d84a2); font-size: 20px; text-shadow: 0 -1px 0 rgba(0, 0, 0, .45);
  }

  /* The banner: the featured things side by side, one at a time, sliding. */
  .banner { position: relative; background: #000; }
  .slides { display: flex; margin: 0; padding: 0; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .slides::-webkit-scrollbar { display: none; }
  .slides li { flex: 0 0 100%; scroll-snap-align: start; }
  .slides a { position: relative; display: block; aspect-ratio: 2 / 1; overflow: hidden; color: #fff; }
  .slides img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; -webkit-user-drag: none; }
  .cap {
    position: absolute; left: 0; right: 0; bottom: 0; display: grid; padding: 26px 14px 12px;
    background: linear-gradient(transparent, rgba(0, 0, 0, .65)); text-shadow: 0 1px 2px rgba(0, 0, 0, .6);
  }
  .cap b { font-size: 19px; }
  .cap span { font-size: 13px; opacity: .85; }
  .dots { position: absolute; right: 12px; bottom: 10px; display: flex; gap: 6px; margin: 0; }
  .dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, .45); transition: background-color .3s; }
  .dots i.on { background: #fff; }

  /* The segments, iOS 4's bar style. */
  .bar { padding: 7px 10px; border-bottom: 1px solid #8f99a6; background: linear-gradient(#e2e7ee, #b4bfcd); }
  .segmented { display: flex; border: 1px solid #4b5a71; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 0 rgba(255, 255, 255, .6); }
  .segmented button {
    flex: 1; height: 30px; padding: 0; border: 0; border-left: 1px solid #4b5a71; color: #fff; cursor: pointer;
    font: 700 13px/1 inherit; font-family: inherit; text-shadow: 0 -1px 0 rgba(0, 0, 0, .4);
    background: linear-gradient(#a4b2c5, #7d90aa 50%, #71859f 51%, #7c8fa8);
  }
  .segmented button:first-child { border-left: 0; }
  .segmented button[aria-checked='true'] { background: linear-gradient(#5f84c3, #3c64a8 50%, #2f579d 51%, #3a62a6); box-shadow: inset 0 1px 3px rgba(0, 0, 0, .35); }
  .segmented button:focus-visible { outline: 2px solid #fff; outline-offset: -3px; }

  /* The list: each product as an app, with its glossy icon and the price button. */
  .rows { margin: 0; padding: 0; list-style: none; }
  .rows li {
    display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; align-items: center; gap: 12px;
    min-height: 84px; padding: 10px 12px; border-bottom: 1px solid #d9d9d9; background: linear-gradient(#fff, #f4f4f4);
  }
  .rows li[hidden] { display: none; }
  .ic { position: relative; display: block; width: 64px; height: 64px; overflow: hidden; border-radius: 12px; background: #eee; box-shadow: 0 1px 3px rgba(0, 0, 0, .35); }
  .ic img { width: 100%; height: 100%; object-fit: cover; }
  .ic::after { content: ''; position: absolute; left: -30%; right: -30%; top: -54%; height: 104%; border-radius: 50%; background: linear-gradient(rgba(255, 255, 255, .55), rgba(255, 255, 255, .1)); }
  .info { display: grid; gap: 2px; min-width: 0; }
  .info b { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 16px; }
  .info span { color: #6d6d72; font-size: 13px; }
  .price {
    display: grid; place-items: center; min-width: 74px; height: 26px; padding: 0 10px; border: 1px solid #8e99a8; border-radius: 5px;
    color: #4c5a6d; font-size: 12px; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 0 #fff;
    background: linear-gradient(#fdfdfe, #dfe3e9 50%, #d3d8e0 51%, #e4e8ee); box-shadow: inset 0 1px 0 #fff;
    transition: min-width .25s var(--ease-entrada), background-color .2s;
  }
  .price:focus-visible { outline: 2px solid #3a76d8; outline-offset: 2px; }
  /* The second step, green, wider: COMPRAR. */
  .price.buy {
    min-width: 96px; border-color: #2c7c12; color: #fff; text-shadow: 0 -1px 0 rgba(0, 0, 0, .35);
    background: linear-gradient(#8fe06a, #55b72f 50%, #43a51c 51%, #56b52e); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .45);
  }
  .all { margin: 0; padding: 14px; text-align: center; font-weight: 700; }
  .all a { color: #385487; }
  .all a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* The rows come in one after another, as the list loaded. */
  @media (prefers-reduced-motion: no-preference) {
    .rows li { animation: row-in var(--dur-media) var(--ease-entrada) both; animation-delay: calc(.2s + var(--i) * 70ms); }
    .price.buy span { animation: buy-in .25s var(--ease-entrada) both; }
  }
  @keyframes row-in { from { opacity: 0; translate: 0 10px; } }
  @keyframes buy-in { from { opacity: 0; scale: .8; } }
</style>

<script>
  import { onPage } from '../scripts/page';
  import { tick } from '../scripts/sounds';

  onPage(signal => {
    const store = document.querySelector<HTMLElement>('.appstore');
    if (!store) return;

    // The price button: one tap, COMPRAR; another, the shop. A tap anywhere else puts the price back.
    const reset = (except?: Element) => store.querySelectorAll<HTMLAnchorElement>('.price.buy').forEach(b => {
      if (b === except) return;
      b.classList.remove('buy');
      b.querySelector('span')!.textContent = b.dataset.price!;
    });
    store.addEventListener('click', e => {
      const b = (e.target as Element).closest<HTMLAnchorElement>('.price');
      reset(b ?? undefined);
      if (!b || b.classList.contains('buy')) return;
      e.preventDefault();
      b.classList.add('buy');
      b.querySelector('span')!.textContent = 'COMPRAR';
      tick();
    }, { signal });
    document.addEventListener('click', e => { if (!store.contains(e.target as Node)) reset(); }, { signal });

    // The segments filter the list; the rows close up smoothly where the browser can (View Transitions).
    const rows = [...store.querySelectorAll<HTMLElement>('.rows li')];
    store.querySelectorAll<HTMLButtonElement>('[data-seg]').forEach(seg => seg.addEventListener('click', () => {
      const apply = () => {
        store.querySelectorAll('[data-seg]').forEach(s => s.setAttribute('aria-checked', String(s === seg)));
        rows.forEach(r => { r.hidden = seg.dataset.seg !== 'todo' && r.dataset.kind !== seg.dataset.seg; });
      };
      if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) { apply(); return; }
      // Names only for this: on a page change they would keep the rows from sliding with the page.
      rows.forEach((r, i) => { r.style.viewTransitionName = `producto-${i}`; });
      document.startViewTransition(apply).finished.finally(() => rows.forEach(r => { r.style.viewTransitionName = ''; }));
    }, { signal }));

    // The banner: its dots follow it, and it moves on by itself every few seconds until touched.
    const slides = store.querySelector<HTMLElement>('.slides')!, dots = [...store.querySelectorAll('.dots i')];
    const at = () => Math.round(slides.scrollLeft / slides.clientWidth);
    slides.addEventListener('scroll', () => dots.forEach((d, i) => d.classList.toggle('on', i === at())), { passive: true, signal });
    let touched = false;
    for (const t of ['pointerdown', 'wheel', 'focusin']) slides.addEventListener(t, () => { touched = true; }, { passive: true, signal });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && dots.length > 1) {
      const timer = setInterval(() => {
        if (touched || document.hidden) return;
        slides.scrollTo({ left: ((at() + 1) % dots.length) * slides.clientWidth, behavior: 'smooth' });
      }, 4500);
      signal.addEventListener('abort', () => clearInterval(timer));
    }
  });
</script>
