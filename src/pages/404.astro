---
// The page that doesn't exist, as the iPhone 4 would say it: an iOS 4 alert, glossy navy glass, one
// button back to the library.
import Base from '../layouts/Base.astro';
---

<Base title="No está en la biblioteca" page="error" description="Esta página no existe.">
  <main class="lost">
    <div class="alert" role="alertdialog" aria-labelledby="lost-title" aria-describedby="lost-text">
      <h1 id="lost-title">No se puede reproducir</h1>
      <p id="lost-text">Esta página no está en tu biblioteca. Puede que se haya movido o que todavía se esté demorando.</p>
      <a class="button" href="/">Volver a la biblioteca</a>
    </div>
  </main>
</Base>

<style>
  /* Apple's alert, over the screen dimmed with iOS's spotlight. */
  .lost { display: grid; place-items: center; min-height: calc(100cqh - var(--sbh)); padding: 16px; background: #000 url('/ios/ui/UIAlertViewDimmingSpotlight.png') center / 100% 100%; }
  .alert {
    width: 284px; padding: 16px; color: #fff; text-align: center;
    border: 0 solid; border-image: url('/ios/ui/UIPopupAlertSheetBackground.png') 60 30 50 30 fill / 30px 15px 25px 15px;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, .45));
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; text-shadow: 0 -1px 0 rgba(0, 0, 0, .55);
  }
  h1 { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
  p { margin: 0 0 12px; font-size: 15px; line-height: 19px; }
  .button {
    display: block; height: 43px; color: #fff; font: 700 17px/43px 'Helvetica Neue', Helvetica, Arial, sans-serif;
    border: 0 solid; border-image: url('/ios/ui/UIPopupAlertSheetDefaultButton.png') 0 10 fill / 0 5px;
  }
  .button:active { border-image-source: url('/ios/ui/UIPopupAlertSheetButtonPress.png'); }
  .button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) { .alert { animation: alert-in .4s ease-out both; } }
  @keyframes alert-in { 0% { scale: .6; opacity: 0; } 45% { scale: 1.08; opacity: 1; } 75% { scale: .97; } 100% { scale: 1; } }
</style>
