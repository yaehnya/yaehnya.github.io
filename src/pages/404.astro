---
// The page that doesn't exist, as the iPhone 4 would say it: an iOS 4 alert, glossy navy glass, one
// button back to the library.
import Base from '../layouts/Base.astro';
---

<Base title="No está en la biblioteca" page="error" description="Esta página no existe.">
  <main class="lost">
    <div class="alert" role="alertdialog" aria-labelledby="lost-title" aria-describedby="lost-text">
      <h1 id="lost-title">No se puede reproducir</h1>
      <p id="lost-text">Esta página no está en tu biblioteca. Puede que se haya movido o que todavía se esté demorando.</p>
      <a class="button" href="/">Volver a la biblioteca</a>
    </div>
  </main>
</Base>

<style>
  .lost { display: grid; place-items: center; min-height: 100svh; padding: 24px; }
  /* iOS 4: a translucent navy panel with a white border, a gloss across its top half, white bold text
     with a dark shadow and a glossy button. */
  .alert {
    position: relative; width: min(284px, 100%); padding: 18px 16px 16px; overflow: hidden; text-align: center;
    border: 2px solid rgba(255, 255, 255, .85); border-radius: 11px; color: #fff;
    background: linear-gradient(rgba(57, 72, 113, .94), rgba(20, 31, 66, .96));
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .35), 0 14px 40px rgba(10, 20, 50, .35);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; text-shadow: 0 -1px 0 rgba(0, 0, 0, .55);
  }
  .alert::before {
    content: ''; position: absolute; left: -30%; right: -30%; top: -120px; height: 160px; pointer-events: none;
    border-radius: 50%; background: linear-gradient(rgba(255, 255, 255, .34), rgba(255, 255, 255, .08));
  }
  h1 { position: relative; margin: 0 0 6px; font-size: 17px; font-weight: 700; }
  p { position: relative; margin: 0 0 16px; font-size: 14px; line-height: 1.35; }
  .button {
    position: relative; display: block; padding: 9px 12px; border-radius: 6px; font-size: 16px; font-weight: 700;
    border: 1px solid rgba(0, 0, 0, .55); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .45);
    background: linear-gradient(rgba(140, 152, 182, .9), rgba(66, 79, 115, .95) 50%, rgba(46, 58, 94, .95) 51%, rgba(56, 70, 108, .95));
    transition: filter var(--dur-micro, .16s);
  }
  .button:hover { filter: brightness(1.12); }
  .button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
</style>
