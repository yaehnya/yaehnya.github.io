---
// Contact, as a text from the iPhone 4: Messages, iOS 4. Yeyo has written first ("amor, cómo
// ESTÁS???", the song); you pick who it goes to (management, booking or press), say who you are and
// write back. Sending works the way the phone did it: your green bubble, the blue progress bar across
// the top, "Entregado". It is a real form underneath: with a form service in `site.form.action` it
// posts there; without one it opens the visitor's mail app addressed to whoever they picked.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const first = site.contact[0];
---

<Base title="Contacto" page="contacto" description="Escríbele a Yeyo: management, booking y prensa.">
  <main class="contact">
    <h1 class="sr-only">Contacto</h1>

    <form class="phone-sms" data-astro-reload method="post" action={site.form.action || undefined}
      data-mailto={site.form.action ? undefined : first?.email} aria-label="Mensaje para Yeyo">
      <header class="navbar">
        <a class="back-btn" href="/">Mensajes</a>
        <b class="who">{site.name.charAt(0) + site.name.slice(1).toLowerCase()}</b>
        <span class="progress" aria-hidden="true"><i></i></span>
      </header>

      <fieldset class="row to">
        <legend>Para:</legend>
        {site.contact.map((c, i) => (
          <label class="token">
            <input type="radio" name="para" value={c.email} checked={i === 0} />
            <span>{c.label}</span>
          </label>
        ))}
      </fieldset>
      <label class="row"><span>De:</span><input name="nombre" autocomplete="name" placeholder="Tu nombre" required /></label>
      <label class="row"><span>Correo:</span><input name="correo" type="email" autocomplete="email" placeholder="Para contestarte" required /></label>

      <ol class="thread" aria-live="polite">
        <li class="direct">O escribe directo: {site.contact.map((c, i) => <>{i > 0 && ' · '}<a href={`mailto:${c.email}`}>{c.label}</a></>)}</li>
        <li class="stamp">Hoy <span class="clock">15:53</span></li>
        <li class="in">amor, cómo ESTÁS???</li>
      </ol>

      <div class="compose">
        <label class="sr-only" for="sms-text">Tu mensaje</label>
        <textarea id="sms-text" name="mensaje" rows="1" placeholder="Mensaje de texto" required></textarea>
        <button class="send" type="submit">Enviar</button>
      </div>
      <input type="hidden" name="subject" value={`Mensaje para ${site.name}`} />
    </form>

  </main>
</Base>

<style>

  /* iOS 4's Messages, the whole screen: Apple's bar and back button, the fields, the thread, the
     compose bar held at the foot. */
  .phone-sms {
    display: grid; grid-template-rows: auto auto auto auto 1fr auto; min-height: calc(100cqh - var(--sbh)); background: #dbe2ed;
    font: 15px/1.3 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #000; text-transform: none; letter-spacing: 0;
  }
  .navbar {
    position: sticky; top: 0; z-index: 2; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 44px; padding: 0 5px;
    background: url('/ios/ui/UINavigationBarDefaultBackground.png') 0 0 / 100% 44px; color: #fff; text-shadow: 0 -1px 0 rgba(0, 0, 0, .45);
  }
  .who { font-size: 20px; }
  .back-btn {
    justify-self: start; height: 30px; padding: 0 7px 0 13px; color: #fff; font: 700 12px/30px 'Helvetica Neue', Helvetica, Arial, sans-serif;
    border: 0 solid; border-image: url('/ios/ui/UINavigationBarDefaultBack.png') 0 10 0 30 fill / 0 5px 0 15px;
  }
  .back-btn:active { border-image-source: url('/ios/ui/UINavigationBarDefaultBackPressed.png'); }
  /* iOS 4's send progress: a blue bar filling across the bottom of the bar. */
  .progress { position: absolute; left: 30px; right: 30px; bottom: 6px; height: 9px; border-radius: 5px; opacity: 0;
    background: linear-gradient(#fff, #d6d6d6); box-shadow: inset 0 1px 1px rgba(0, 0, 0, .4); transition: opacity .2s; }
  .progress i { display: block; width: var(--sent, 0%); height: 100%; border-radius: inherit; background: linear-gradient(#a7c5f4, #3f7ee3 55%, #2f6fd8); transition: width 1.1s cubic-bezier(.3, .1, .3, 1); }
  .phone-sms.sending .progress { opacity: 1; }
  .phone-sms.sending .who { visibility: hidden; }

  .row {
    display: flex; align-items: center; gap: 8px; min-height: 42px; margin: 0; padding: 4px 10px;
    border: 0; border-bottom: 1px solid #c8c7cc; background: #fff;
  }
  .row > span, .row legend { color: #8e8e93; font-size: 15px; }
  .to legend { float: left; margin-right: 6px; padding: 0; }
  .row input { flex: 1; min-width: 0; padding: 6px 0; border: 0; background: none; font: inherit; color: #000; }
  .row input:focus { outline: none; }
  .row:focus-within { background: #f6f9ff; }
  .token { position: relative; display: inline-block; margin: 3px 4px 3px 0; cursor: pointer; }
  .token input { position: absolute; opacity: 0; pointer-events: none; }
  .token span {
    display: inline-block; padding: 3px 10px; border-radius: 13px; color: #1a4a94; font-size: 14px;
    background: linear-gradient(#e3edfd, #c5d8f7); box-shadow: inset 0 0 0 1px #9ab6e6;
  }
  .token input:checked + span { color: #fff; background: linear-gradient(#7fb0f5, #3a76d8); box-shadow: inset 0 0 0 1px #2a5bb0; text-shadow: 0 -1px 0 rgba(0, 0, 0, .3); }
  .token input:focus-visible + span { outline: 2px solid #3a76d8; outline-offset: 2px; }

  .thread { display: grid; align-content: start; gap: 10px; margin: 0; padding: 10px 10px 14px; list-style: none; }
  .direct { justify-self: center; color: #6d7380; font-size: 11px; font-weight: 700; text-align: center; text-shadow: 0 1px 0 #fff; }
  .direct a { color: #385487; }
  .stamp { justify-self: center; color: #6d7380; font-size: 12px; font-weight: 700; text-shadow: 0 1px 0 #fff; }
  /* Bubbles are added by the script, so their rules reach inside the thread (:global). */
  .thread :global(.in), .thread :global(.out) {
    position: relative; max-width: 78%; padding: 7px 13px; border-radius: 17px; overflow-wrap: anywhere; white-space: pre-wrap;
    box-shadow: 0 1px 1px rgba(0, 0, 0, .25), inset 0 1px 0 rgba(255, 255, 255, .7);
  }
  .thread :global(.in) { justify-self: start; border-bottom-left-radius: 5px; background: linear-gradient(#fdfdfd, #e3e3e3); }
  .thread :global(.out) { justify-self: end; border-bottom-right-radius: 5px; background: linear-gradient(#cdf7a6, #8ee05b 55%, #77d146); }
  .thread :global(.note) { justify-self: end; margin-top: -6px; color: #6d7380; font-size: 11px; font-weight: 700; }

  .compose {
    position: sticky; bottom: 0; display: flex; align-items: end; gap: 8px; padding: 7px 8px;
    background: linear-gradient(#eef0f3, #cdd2da); border-top: 1px solid #a3a8b2;
  }
  .compose textarea {
    flex: 1; min-height: 32px; max-height: 120px; padding: 6px 12px; border: 1px solid #9ea3ad; border-radius: 16px;
    background: #fff; box-shadow: inset 0 1px 2px rgba(0, 0, 0, .25); font: inherit; resize: none; field-sizing: content;
  }
  .compose textarea:focus { outline: none; border-color: #6a8fd1; }
  .send {
    padding: 7px 14px; border: 1px solid #1e5a12; border-radius: 15px; color: #fff; font: 700 14px/1 inherit; cursor: pointer;
    background: linear-gradient(#a4e07c, #5bb532 50%, #45a11e 51%, #57b42d); text-shadow: 0 -1px 0 rgba(0, 0, 0, .35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .45);
  }
  .send:focus-visible { outline: 2px solid #3a76d8; outline-offset: 2px; }


  /* New bubbles pop in like iOS's: from small, at their corner. */
  @media (prefers-reduced-motion: no-preference) {
    .thread :global(li.new) { animation: pop .38s cubic-bezier(.2, 1.4, .4, 1) both; transform-origin: bottom right; }
    .thread :global(li.in.new) { transform-origin: bottom left; }
  }
  @keyframes pop { from { opacity: 0; scale: .6; } }
</style>

<script>
  import '../scripts/mailto-forms';
  import { onPage } from '../scripts/page';
  import { tick, swoosh, vibrate, received } from '../scripts/sounds';

  onPage(signal => {
    const form = document.querySelector<HTMLFormElement>('.phone-sms');
    if (!form) return;

    // The status bar and the thread's stamp show the real time.
    const now = new Date(), hh = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}`;
    form.querySelectorAll('.clock').forEach(el => { el.textContent = hh; });

    // Yeyo's message arrives as the page opens: it pops in, with the phone's chime.
    const first = form.querySelector('.thread .in');
    if (first) { first.classList.add('new'); const t = setTimeout(received, 380); signal.addEventListener('abort', () => clearTimeout(t)); }

    // The keyboard ticks as you type, as the iPhone's did.
    form.addEventListener('input', e => { if ((e as InputEvent).inputType?.startsWith('insert') || (e as InputEvent).inputType?.startsWith('delete')) tick(); }, { signal });

    // Sending, as the phone did: your bubble, the progress bar, "Entregado", then off it goes (the form's
    // own submit: a form service, or the mail app via mailto-forms.ts).
    const thread = form.querySelector('.thread')!, text = form.querySelector<HTMLTextAreaElement>('textarea')!;
    let ready = false;
    // In the capture phase, so it runs before mailto-forms.ts and can hold the send back.
    form.addEventListener('submit', e => {
      if (ready) return;                                   // the second time round, let it go
      e.preventDefault();
      e.stopImmediatePropagation();
      if (!form.reportValidity()) return;
      const bubble = Object.assign(document.createElement('li'), { className: 'out new', textContent: text.value.trim() });
      thread.append(bubble);
      swoosh();
      vibrate(15);
      form.classList.add('sending');
      requestAnimationFrame(() => form.style.setProperty('--sent', '100%'));
      setTimeout(() => {
        form.classList.remove('sending');
        thread.append(Object.assign(document.createElement('li'), { className: 'note new', textContent: 'Entregado' }));
        ready = true;
        form.requestSubmit();
        ready = false;
        form.style.setProperty('--sent', '0%');
        text.value = '';
      }, 1300);
    }, { capture: true, signal });
  });
</script>
