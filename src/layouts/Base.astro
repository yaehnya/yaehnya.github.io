---
// Every page but the game's. The whole site is inside an iPhone 4 running iOS 4: the photo's iPhone on
// its side with a little white around it, and on its screen the status bar, the page, and behind it
// the springboard with the sections as apps. The photo's home button is the home button. The pages
// change without reloading (ClientRouter), so the song goes on playing; the iPhone and the status bar
// stay put while the screen under them changes (transition:persist).
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Meta from '../components/Meta.astro';
import StatusBar from '../components/StatusBar.astro';
import HomeButton from '../components/HomeButton.astro';
import SideSwitch from '../components/SideSwitch.astro';
import Springboard from '../components/Springboard.astro';
import Notice from '../components/Notice.astro';
import Switcher from '../components/Switcher.astro';
import { site, type Page } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  page: Page;
  bar?: 'gris' | 'negro' | 'translucido';   // the status bar: iOS 4's grey; black (the iPod); see-through over a picture
  image?: string;          // the share picture for this page, 1200 × 630 (default: public/og/yeyo.jpg)
}

const { title, description = site.description, page, bar = 'gris', image } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <Meta title={fullTitle} description={description} image={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/helvetica-neue-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/helvetica-neue-regular.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body data-bar={bar} data-page={page}>
    <div class="device" transition:persist="device">
      <img class="bezel" src="/fotos/iphone.webp" alt="" width="498" height="926" />
      <HomeButton />
      <SideSwitch />
    </div>
    <div class="screen" id="screen">
      <div class="display" id="display">
        <StatusBar />
        <!-- The page: what slides in and out, and what shrinks away when the home button is pressed. -->
        <div class="scroller" id="scroller">
          <div id="world">
            <slot />
          </div>
        </div>
        <Springboard page={page} />
        <Switcher />
        <Notice />
      </div>
    </div>
    <!-- Above the screen: the first visit's callout at the home button, and the side switch's bell. -->
    <p class="guide" role="status" hidden><b>Este es el botón de inicio</b><span>Un toque: las apps. Dos toques: la música.</span></p>
    <div class="ring-hud" aria-hidden="true" hidden><img class="ring" src="/ios/ui/ring.png" alt="" /><img class="silent" src="/ios/ui/silent.png" alt="" /></div>
    <!-- The screen's points, scaled to the photo's screen before the first paint (and again on every
         page, and when the window changes: scripts/transitions.ts). -->
    <script is:inline>
      (function () {
        var s = document.getElementById('screen'), d = document.getElementById('display');
        d.style.zoom = String(s.clientWidth / (matchMedia('(orientation: portrait), (pointer: coarse) and (max-height: 600px)').matches ? 320 : 480));
      })();
    </script>
    <slot name="overlay" />
  </body>
</html>

<script>
  import '../scripts/transitions';
  import '../scripts/device';
</script>
