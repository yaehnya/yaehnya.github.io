---
// iOS 4's status bar across the top of every page: signal and carrier on the left, the time in the
// middle, the battery on the right. The time is the real one, and so is the battery where the browser
// tells (Chrome, Edge, Opera). A small ▶ shows while a song plays, as on the iPhone, and tapping the bar
// scrolls back to the top, as tapping the iPhone's did.
//
// It stays put while the pages change under it (transition:persist). Its look comes from the page,
// <body data-bar>: grey, iOS 4's default; black, the iPod's; translucent over a picture (Fechas) and
// over the springboard.
---

<button class="statusbar" type="button" transition:persist="statusbar" aria-label="Volver arriba">
  <span class="sb-l" aria-hidden="true">
    <span class="bars"><i></i><i></i><i></i><i></i><i></i></span>
    <span class="carrier">Telcel</span>
    <svg class="wifi" viewBox="0 0 16 12"><path d="M8 11.6 5.5 8.9a3.5 3.5 0 0 1 5 0z" /><path d="M3.4 6.6a6.6 6.6 0 0 1 9.2 0l-1.4 1.5a4.6 4.6 0 0 0-6.4 0z" /><path d="M1.2 4.3a9.8 9.8 0 0 1 13.6 0l-1.4 1.5a7.8 7.8 0 0 0-10.8 0z" /></svg>
  </span>
  <span class="sb-time" aria-hidden="true"></span>
  <span class="sb-r" aria-hidden="true">
    <svg class="sb-play" viewBox="0 0 10 10" hidden><path d="M2 1v8l7-4z" /></svg>
    <span class="pct">100 %</span>
    <span class="batt"><i></i><svg class="bolt" viewBox="0 0 10 12" hidden><path d="M6 0 1 7h3l-1 5 5-7H5z" /></svg></span>
  </span>
</button>

<style>
  .statusbar {
    --h: 20px;
    position: fixed; top: 0; left: 0; right: 0; z-index: 170; display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; height: var(--h); margin: 0; padding: 0 6px; border: 0; cursor: default;
    font: 700 12px/1 'Helvetica Neue', Helvetica, Arial, sans-serif; letter-spacing: 0; text-transform: none;
    /* iOS 4's default bar: light grey, a darker line under it, black type embossed with white. */
    color: #111; background: linear-gradient(#ececec, #c6c6c6); box-shadow: inset 0 -1px 0 #8d8d8d;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .6);
    view-transition-name: statusbar;
    transition: background-color var(--dur-media), color var(--dur-media);
    -webkit-tap-highlight-color: transparent;
  }
  @media (min-width: 900px) { .statusbar { --h: 22px; font-size: 13px; } }
  :global(body[data-bar='negro']) .statusbar { color: #fff; background: #000; box-shadow: none; text-shadow: none; }
  :global(body[data-bar='translucido']) .statusbar, :global(html.sb-open) .statusbar {
    color: #fff; background: rgba(0, 0, 0, .42); box-shadow: none; text-shadow: 0 -1px 0 rgba(0, 0, 0, .35);
  }
  :global(html[data-intro]) .statusbar { display: none; }
  /* Arriving from the intro: the bar drops in, as it did when the iPhone woke. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.arriving) .statusbar { animation: sb-in .6s .25s var(--ease-entrada) both; }
  }
  @keyframes sb-in { from { translate: 0 -100%; } }
  .statusbar:focus-visible { outline: 2px solid #3a76d8; outline-offset: -2px; }

  .sb-l { display: flex; align-items: center; gap: 4px; }
  .bars { display: flex; align-items: end; gap: 1px; height: 11px; }
  .bars i { width: 3px; background: currentColor; border-radius: .5px; }
  .bars i:nth-child(1) { height: 4px; } .bars i:nth-child(2) { height: 5.5px; } .bars i:nth-child(3) { height: 7px; }
  .bars i:nth-child(4) { height: 8.5px; } .bars i:nth-child(5) { height: 10px; opacity: .35; }
  .wifi { width: 15px; height: 11px; fill: currentColor; }
  .sb-time { justify-self: center; }
  .sb-r { display: flex; justify-content: end; align-items: center; gap: 5px; }
  .sb-play { width: 9px; height: 9px; fill: currentColor; }
  .pct { font-weight: 600; }
  /* The battery: an outline with its nub, filled to the level, with a gloss across the fill. */
  .batt { position: relative; width: 24px; height: 11px; border: 1px solid currentColor; border-radius: 2.5px; }
  .batt::after { content: ''; position: absolute; right: -3.5px; top: 2.5px; width: 2.5px; height: 4px; background: currentColor; border-radius: 0 1px 1px 0; }
  .batt i {
    position: absolute; left: 1px; top: 1px; bottom: 1px; width: calc((100% - 2px) * var(--level, 1)); border-radius: 1px;
    background: linear-gradient(rgba(255, 255, 255, .45), transparent 55%), currentColor;
  }
  .batt.charging i { background: linear-gradient(rgba(255, 255, 255, .5), transparent 55%), #4cd964; }
  .bolt { position: absolute; left: 50%; top: 50%; width: 8px; height: 10px; translate: -50% -50%; fill: currentColor; stroke: rgba(0, 0, 0, .35); stroke-width: .6; }
</style>

<script>
  import { player } from '../scripts/player';
  import { lenis } from '../scripts/transitions';

  const bar = document.querySelector<HTMLButtonElement>('.statusbar')!;

  // The time, as iOS 4 in Mexico wrote it: 9:41 p.m.
  const time = bar.querySelector('.sb-time')!;
  const tick = () => {
    const d = new Date(), h = d.getHours();
    time.textContent = `${h % 12 || 12}:${String(d.getMinutes()).padStart(2, '0')} ${h < 12 ? 'a.m.' : 'p.m.'}`;
    setTimeout(tick, 60_000 - (d.getSeconds() * 1000 + d.getMilliseconds()) + 50);   // on the minute
  };
  tick();

  // The battery, where the browser shares it.
  type Battery = EventTarget & { level: number; charging: boolean };
  const nav = navigator as Navigator & { getBattery?: () => Promise<Battery> };
  nav.getBattery?.().then(b => {
    const pct = bar.querySelector('.pct')!, batt = bar.querySelector<HTMLElement>('.batt')!;
    const show = () => {
      pct.textContent = `${Math.round(b.level * 100)} %`;
      batt.style.setProperty('--level', String(b.level));
      batt.classList.toggle('charging', b.charging);
      batt.querySelector('.bolt')!.toggleAttribute('hidden', !b.charging);
    };
    show();
    b.addEventListener('levelchange', show);
    b.addEventListener('chargingchange', show);
  }).catch(() => {});

  // ▶ while something plays.
  const play = bar.querySelector('.sb-play')!;
  const playing = () => play.toggleAttribute('hidden', player.paused);
  player.addEventListener('play', playing);
  player.addEventListener('pause', playing);

  // A tap on the bar goes back to the top.
  bar.addEventListener('click', () => {
    if (lenis) lenis.scrollTo(0, { duration: .8 });
    else scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  });
</script>
