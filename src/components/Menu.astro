---
// "Menú" at the top opens a panel that drops from the top edge and bounces a little as it lands.
// It is a popover: Escape, a click outside or picking a link closes it. The game is the glass ball.
import GlassBall from './GlassBall.astro';
import { site, type Page } from '../data/site';

interface Props {
  page: Page;
  tone?: 'dark' | 'light';     // the bar's text: light for pages that open on a dark picture
}
const { page, tone = 'dark' } = Astro.props;

const items: { href: string; label: string; page: Page }[] = [
  { href: '/musica', label: 'Música', page: 'musica' },
  { href: '/fechas', label: 'Fechas', page: 'fechas' },
  { href: '/tienda', label: 'Tienda', page: 'tienda' },
  { href: '/contacto', label: 'Contacto', page: 'contacto' },
];
---

<header class="bar" data-tone={tone}>
  {page !== 'home' && <a class="mark" href="/">{site.name}</a>}
  <button class="open label" type="button" popovertarget="menu">Menú <span class="lines" aria-hidden="true"></span></button>
</header>

<nav id="menu" popover aria-label="Menú">
  <button class="close label" type="button" popovertarget="menu" popovertargetaction="hide">Cerrar ✕</button>
  <ul>
    {items.map((it, i) => (
      <li style={`--i: ${i}`}>
        <a href={it.href} aria-current={page === it.page ? 'page' : undefined}>
          <span class="stretch">{it.label}</span>
        </a>
      </li>
    ))}
    <li style={`--i: ${items.length}`}>
      <a class="game" href="/juego" aria-label="El juego" title="El juego" aria-current={page === 'juego' ? 'page' : undefined}>
        <GlassBall size={58} id="menu-ball" />
      </a>
    </li>
  </ul>
  <a class="home wordmark" href="/" style={`--i: ${items.length + 1}`}><span class="wm">{site.name}</span>{site.tagline && <small>{site.tagline}</small>}</a>
</nav>

<style>
  .bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; align-items: center;
    padding: 14px 20px; pointer-events: none;
  }
  .bar > * { pointer-events: auto; }
  .bar[data-tone='light'] { color: #fff; text-shadow: 0 1px 8px rgba(0, 0, 0, .45); }
  .bar[data-tone='light'] .open { color: inherit; }
  .mark { display: inline-block; font: 700 20px/1 var(--sans); letter-spacing: -.045em; scale: var(--stretch); transform-origin: left center; }
  .open {
    display: inline-flex; align-items: center; gap: 10px; margin-left: auto; padding: 8px 0;
    border: 0; background: none; color: var(--ink); font-weight: 600; cursor: pointer;
  }
  .lines { width: 20px; height: 7px; border-block: 1.5px solid currentColor; transition: height .2s; }
  .open:hover .lines { height: 9px; }

  /* The panel: hidden above the top edge, drops in with --bounce, leaves quickly. */
  #menu {
    inset: 0 0 auto; width: 100%; max-width: none; height: auto; max-height: 100svh; margin: 0;
    padding: 72px 24px 44px; border: 0; border-bottom: 1px solid var(--line); overflow: auto;
    background: var(--bg); color: var(--ink); box-shadow: 0 24px 48px rgba(0, 0, 0, .1);
    translate: 0 -105%;
    transition: translate .45s cubic-bezier(.6, 0, .9, .4), display .45s allow-discrete, overlay .45s allow-discrete;
  }
  #menu:is(:popover-open, .\:popover-open) {
    display: grid; justify-items: center; gap: 44px;
    translate: 0 0;
    transition: translate .85s var(--bounce), display .85s allow-discrete, overlay .85s allow-discrete;
    @starting-style { translate: 0 -105%; }
  }
  #menu::backdrop {
    background: rgba(0, 0, 0, 0);
    transition: background-color .45s, display .45s allow-discrete, overlay .45s allow-discrete;
  }
  #menu:popover-open::backdrop {
    background: rgba(0, 0, 0, .16);
    @starting-style { background: rgba(0, 0, 0, 0); }
  }

  .close { position: absolute; top: 22px; right: 20px; border: 0; background: none; color: var(--ink); font-weight: 600; cursor: pointer; }

  ul { display: grid; justify-items: center; gap: 2px; margin: 0; padding: 0; list-style: none; }
  ul a {
    display: block; font: 700 clamp(44px, 8vw, 108px)/.9 var(--sans); letter-spacing: -.045em;
    text-transform: uppercase; text-align: center; transition: opacity .2s;
  }
  ul:hover a { opacity: .3; }
  ul a:hover, ul a:focus-visible { opacity: 1; }
  ul a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: .06em; text-underline-offset: .1em; }
  ul a.game { margin-top: 18px; font-size: 0; line-height: 0; transition: opacity .2s, scale .35s var(--bounce); }
  ul a.game:hover, ul a.game:focus-visible { scale: 1.12; }
  .home { font-size: clamp(22px, 2.4vw, 32px); }

  /* The links follow the panel down one after another. */
  #menu li, #menu .home {
    transition: opacity .35s ease calc(.12s + var(--i) * .06s), translate .7s var(--bounce) calc(.12s + var(--i) * .06s);
  }
  #menu:popover-open li, #menu:popover-open .home {
    @starting-style { opacity: 0; translate: 0 -28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #menu, #menu:popover-open { translate: none; transition-duration: .1s; }
    #menu:popover-open { @starting-style { translate: none; opacity: 0; } }
    #menu li, #menu .home { transition: none; }
  }
</style>

<script>
  // Popover is new enough that some browsers still in use lack it; load the polyfill only there.
  if (!('popover' in HTMLElement.prototype)) import('@oddbird/popover-polyfill');

  // The glass ball measures itself on a resize, and can only be measured once the panel is open.
  const menu = document.getElementById('menu')!;
  menu.addEventListener('toggle', e => { if ((e as ToggleEvent).newState === 'open') dispatchEvent(new Event('resize')); });
</script>
