---
// Spotify, YouTube and Instagram floating at the bottom of every page, each a drop of glass with the
// logo inside. Drawn here in CSS (a bead with a bright rim and a sheen); in Chromium, once the page is
// idle, scripts/glass.ts swaps in liquid-glass-react's, which bends what passes under it.
import { site } from '../data/site';
import { icons } from '../data/icons';

interface Props { tone?: 'dark' | 'light' }   // light: the page under it is dark
const { tone = 'dark' } = Astro.props;

const links = [
  { id: 'spotify', label: 'Spotify', href: site.social.spotify },
  { id: 'youtube', label: 'YouTube', href: site.social.youtube },
  { id: 'instagram', label: 'Instagram', href: site.social.instagram },
] as const;
---

<nav class="social" aria-label="Redes" data-tone={tone} data-glass-social={JSON.stringify(links)}>
  {links.map(l => (
    <a class="social-link" href={l.href} target="_blank" rel="noopener" aria-label={l.label}>
      <span class="bead"><span class="sheen" set:html={icons[l.id]} /></span>
    </a>
  ))}
</nav>

<script>
  import '../scripts/glass';
</script>

<style>
  .social {
    position: fixed; left: 50%; bottom: 20px; z-index: 20; translate: -50% 0;
    display: flex; gap: 18px; align-items: center; view-transition-name: social;
  }
  .social :global(.social-link) { display: block; color: var(--ink); transition: scale .35s var(--bounce); }
  .social[data-tone='light'] :global(.social-link) { color: #fff; }
  .social :global(.social-link:hover) { scale: 1.08; }
  .social :global(.social-link svg) { width: 24px; height: 24px; }
  /* The CSS glass: the same size, light and shadow as the library's, frosted where it can be. */
  .bead {
    position: relative; display: block; width: 54px; height: 54px; border-radius: 50%;
    -webkit-backdrop-filter: blur(5px) saturate(1.4); backdrop-filter: blur(5px) saturate(1.4);
    box-shadow: 0 8px 22px rgba(0, 0, 0, .14), 0 1px 3px rgba(0, 0, 0, .12);
  }
</style>
