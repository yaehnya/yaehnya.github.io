---
// Cover Flow, as on the iPod, on white: a row of covers you scroll sideways, the one in the middle
// facing you, the others turned toward it and stacked on either side, all of them reflected on the
// floor. Under the middle one, its two lines in the iPod's bold Helvetica.
//
// The turning is a scroll-driven animation (each cover follows its own view timeline across the
// scroller), after scroll-driven-animations.style/demos/cover-flow; browsers without them get the same
// motion from a scroll listener. Scroll snapping keeps one cover in the middle. Click a cover at the
// side to bring it to the middle; click the one in the middle and it turns over, as in iTunes: on its
// back, a song plays and links to where to hear it, a news item tells it, a photo gives its credit.
import { site } from '../data/site';
const items = site.coverflow;
const start = Math.max(0, items.findIndex(c => 'start' in c && c.start));
const kinds = { foto: 'Foto', cancion: 'Sencillo', noticia: 'Noticia' };
const year = (iso?: string) => iso?.slice(0, 4);
import { srcset, sized } from '../data/images';
---

<section class="coverflow" aria-label="Fotos, música y noticias">
  <div class="scroller" tabindex="0" data-start={start} data-lenis-prevent>
    <ul class="flow">
      {items.map((c, i) => {
        const near = Math.abs(i - start) < 4;
        const song = c.song !== undefined ? site.songs[c.song] : undefined;
        return (
          <li data-title={c.title} data-subtitle={c.subtitle ?? ''} data-song={c.song}>
            <div class="cover" data-kind={c.kind}>
              <div class="card">
                <button class="front" type="button" aria-label={`${c.title}: dar la vuelta`} aria-expanded="false" draggable="false">
                  <img class="art" src={sized(c.image, 640)} srcset={srcset(c.image)} sizes="(orientation: portrait) 200px, 280px" alt={c.alt} width="600" height="600" loading={near ? 'eager' : 'lazy'} draggable="false" />
                  <img class="reflection" src={sized(c.image, 640)} srcset={srcset(c.image)} sizes="(orientation: portrait) 200px, 280px" alt="" aria-hidden="true" width="600" height="600" loading={near ? 'eager' : 'lazy'} draggable="false" />
                </button>
                <div class="back" inert>
                  <p class="kind">{kinds[c.kind]}{song?.date && ` · ${year(song.date)}`}</p>
                  <h3>{c.title}</h3>
                  {c.subtitle && c.kind !== 'foto' && <p class="sub">{c.subtitle}</p>}
                  {song?.audio && (
                    <button class="listen" type="button" data-src={song.audio} data-title={song.title}>
                      <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>
                      <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4.5h3.6v15H6.5zM13.9 4.5h3.6v15h-3.6z" /></svg>
                      <span>Escuchar</span>
                    </button>
                  )}
                  {song && (
                    <p class="links">
                      {song.apple && <a href={song.apple} target="_blank" rel="noopener">Apple Music ↗</a>}
                      {song.spotify && <a href={song.spotify} target="_blank" rel="noopener">Spotify ↗</a>}
                      {song.youtube && <a href={song.youtube} target="_blank" rel="noopener">YouTube ↗</a>}
                    </p>
                  )}
                  {c.text && <p class="text">{c.text}</p>}
                  {c.kind === 'foto' && <p class="text">{c.credit ?? '[PENDIENTE: lugar, fecha y crédito de la foto]'}</p>}
                  {c.href && <a class="more" href={c.href}>{c.kind === 'cancion' ? 'Ver en Música' : c.kind === 'noticia' ? 'Ver las fechas' : 'Ver más'} →</a>}
                  <button class="turn" type="button" aria-label="Volver a la portada">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4.5h4.5" /></svg>
                  </button>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
  <p class="caption" aria-live="polite">
    <b>{items[start]?.title}</b>
    <span>{items[start]?.subtitle}</span>
  </p>
</section>

<style>
  .coverflow {
    --s: min(32cqw, 47cqh);                          /* a cover's side, as on the iPod in landscape */
    position: relative; display: grid; align-content: center; justify-items: center;
    height: calc(100cqh - var(--sbh)); padding: 4px 0 14px; overflow: hidden; background: var(--bg);   /* one screen, no page scroll */
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;  /* the iPod's, since 2007 */
  }
  @container display (orientation: portrait) { .coverflow { --s: 54cqw; padding-bottom: 40px; } }

  .scroller {
    --step: calc(var(--s) * .22);                    /* how far apart the covers at the sides sit */
    position: relative;                              /* the covers' offsetParent, for the script */
    width: 100%; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none; outline: none;
    perspective: calc(var(--s) * 2.4); perspective-origin: 50% 45%;
    cursor: grab;
  }
  .scroller::-webkit-scrollbar { display: none; }
  .scroller.dragging { scroll-snap-type: none; cursor: grabbing; }
  .scroller:focus-visible { outline: 1.5px solid var(--ink); outline-offset: -6px; }

  .flow {
    display: flex; margin: 0; padding: calc(var(--s) * .12) 0 calc(var(--s) * .62); list-style: none;
    transform-style: preserve-3d;
  }
  .flow li {
    position: relative; flex: 0 0 var(--step); height: var(--s);
    scroll-snap-align: center; transform-style: preserve-3d;
    view-timeline: --cover inline;
  }
  /* Room so the first and the last cover can reach the middle: real boxes, not margins, because the
     end margin of the last cover does not count as something to scroll to, and on a wide screen
     there would be nothing left to scroll. */
  .flow::before, .flow::after { content: ''; flex: 0 0 calc(50% - var(--step) / 2); }

  .cover {
    position: absolute; left: 50%; top: 0; display: block; width: var(--s); height: var(--s); margin-left: calc(var(--s) / -2);
    transform-style: preserve-3d; transform: translateX(calc(var(--s) * .44)) translateZ(calc(var(--s) * -.4)) rotateY(-70deg);
    -webkit-tap-highlight-color: transparent; user-select: none;
  }
  /* The cover is a card with two faces: the artwork (and its reflection) in front, the details behind.
     It turns over around its upright axis, like an album in iTunes' Cover Flow. */
  .card {
    position: absolute; inset: 0; transform-style: preserve-3d;
    transition: transform .75s cubic-bezier(.65, 0, .35, 1);
  }
  li.flipped .card { transform: rotateY(180deg); }
  .front, .back { position: absolute; inset: 0; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .front { display: block; padding: 0; border: 0; background: none; cursor: pointer; }
  .front:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .art, .reflection { position: absolute; left: 0; width: 100%; height: 100%; object-fit: cover; background: var(--panel); }
  .art { top: 0; box-shadow: 0 0 0 .5px rgba(0, 0, 0, .08); }
  /* The floor: the cover upside down under itself, fading out, as on the iPod's white Cover Flow. */
  .reflection {
    top: calc(100% + 2px); scale: 1 -1; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, .42));
    mask-image: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, .42));
  }

  /* The back: white, the iPod's bold Helvetica, sized to the cover. */
  .back {
    --u: calc(var(--s) / 100);
    transform: rotateY(180deg); display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--u) * 2.2);
    padding: calc(var(--u) * 8); background: #fff; color: var(--ink); text-align: left;
    box-shadow: 0 0 0 1px #e4e4e4, 0 18px 40px rgba(0, 0, 0, .08);
    font-size: calc(var(--u) * 4.4); line-height: 1.3;
  }
  .back .kind { margin: 0; color: var(--muted); font-size: calc(var(--u) * 3.4); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .back h3 { margin: 0; font-size: calc(var(--u) * 8); line-height: 1.02; letter-spacing: -.03em; }
  .back .sub { margin: 0; color: #4a4a4a; font-weight: 700; }
  .back .text { margin: 0; color: #4a4a4a; }
  .listen {
    display: inline-flex; align-items: center; gap: calc(var(--u) * 2.4); margin-top: calc(var(--u) * 2);
    padding: calc(var(--u) * 2.6) calc(var(--u) * 5) calc(var(--u) * 2.6) calc(var(--u) * 3.6);
    border: 0; border-radius: 999px; background: var(--ink); color: #fff; cursor: pointer;
    font: 700 calc(var(--u) * 4.2)/1 'Helvetica Neue', Helvetica, Arial, sans-serif;
    transition: scale var(--dur-micro, .16s);
  }
  .listen:active { scale: .96; }
  .listen svg { width: calc(var(--u) * 5); height: calc(var(--u) * 5); fill: currentColor; }
  .listen .pause, .listen.on .play { display: none; }
  .listen.on .pause { display: block; }
  .links { display: flex; flex-wrap: wrap; gap: calc(var(--u) * 1.5) calc(var(--u) * 4); margin: 0; font-size: calc(var(--u) * 3.6); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .links a:hover, .more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .more { margin-top: auto; font-weight: 700; }
  .turn {
    position: absolute; right: calc(var(--u) * 5); bottom: calc(var(--u) * 5); display: grid; place-items: center;
    width: calc(var(--u) * 10); height: calc(var(--u) * 10); padding: 0; border: 1px solid #ddd; border-radius: 50%;
    background: #fff; color: var(--ink); cursor: pointer;
  }
  .turn svg { width: 55%; height: 55%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Each cover turns to face you as it passes the middle: from the step before to the step after it
     (one cover's spacing either side), turned toward the middle and pushed back the rest of the way. */
  @keyframes face {
    0% { transform: translateX(calc(var(--s) * .44)) translateZ(calc(var(--s) * -.4)) rotateY(-70deg); }
    50% { transform: translateX(0) translateZ(calc(var(--s) * .04)) rotateY(0deg); }
    100% { transform: translateX(calc(var(--s) * -.44)) translateZ(calc(var(--s) * -.4)) rotateY(70deg); }
  }
  @supports ((animation-timeline: view()) and (animation-range: entry)) {
    .cover { animation: face linear both; }
    /* The timeline in a rule of its own: in one rule, the CSS minifier folds it into the `animation`
       shorthand, which browsers do not accept there, and the whole declaration is dropped. */
    .flow li > .cover {
      animation-timeline: --cover;
      animation-range: cover calc(50% - var(--step)) cover calc(50% + var(--step));
    }
  }

  .caption {
    /* Under the cover, over its reflection, as on the iPod: the title in bold, the artist in grey. */
    display: grid; justify-items: center; align-content: start; gap: 1px; min-height: 34px; margin: calc(var(--s) * -.36) 16px 0;
    position: relative; z-index: 1; text-align: center; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 700; font-size: 14px; line-height: 17px; letter-spacing: 0; transition: opacity .2s;
  }
  .caption span { color: #6d6d6d; font-size: 12px; line-height: 15px; }

  /* Arriving from the intro, whose phone screen came up into this: the covers land, a touch too
     close at first, and settle; the caption follows. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.arriving) .scroller { animation: land 1.1s cubic-bezier(.16, 1, .3, 1) both; }
    :global(html.arriving) .caption { animation: caption-in .7s .3s cubic-bezier(.16, 1, .3, 1) both; }
  }
  @keyframes land { from { scale: 1.14; } }
  @keyframes caption-in { from { opacity: 0; translate: 0 10px; } }
  .caption.changing { opacity: 0; }
</style>

<script>
  // Behaviour around the CSS: open on the starting cover, keep the caption in step, turn a mouse wheel
  // into sideways scrolling, drag with the mouse, click to bring a cover to the middle or to turn the
  // middle one over, play songs from the backs, and (for browsers without scroll-driven animations)
  // turn the covers from here.
  import { player, playTrack, nowPlaying } from '../scripts/player';
  import { onPage } from '../scripts/page';

  onPage(signal => {
    for (const flow of document.querySelectorAll<HTMLElement>('.coverflow')) {
      const scroller = flow.querySelector<HTMLElement>('.scroller')!;
      const items = [...scroller.querySelectorAll<HTMLLIElement>('li')];
      const caption = flow.querySelector<HTMLElement>('.caption')!;
      const native = CSS.supports('(animation-timeline: view()) and (animation-range: entry)');

      const centreOf = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2;
      const middle = () => scroller.scrollLeft + scroller.clientWidth / 2;
      const current = () => {
        let best = 0, bd = Infinity;
        items.forEach((li, i) => { const d = Math.abs(centreOf(li) - middle()); if (d < bd) { bd = d; best = i; } });
        return best;
      };
      const go = (i: number, smooth = true) => {
        const li = items[Math.max(0, Math.min(items.length - 1, i))];
        scroller.scrollTo({ left: centreOf(li) - scroller.clientWidth / 2, behavior: smooth ? 'smooth' : 'instant' });
      };

      // Turning a cover over and back. Only its back's controls are reachable while it shows.
      const flip = (li: HTMLLIElement, on: boolean, focus = false) => {
        li.classList.toggle('flipped', on);
        const back = li.querySelector<HTMLElement>('.back')!;
        back.inert = !on;
        li.querySelector('.front')!.setAttribute('aria-expanded', String(on));
        if (focus) (on ? back.querySelector<HTMLElement>('button, a') : li.querySelector<HTMLElement>('.front'))?.focus({ preventScroll: true });
      };
      const unflip = () => items.forEach(li => { if (li.classList.contains('flipped')) flip(li, false); });

      // The caption: the middle cover's two lines, with a quick fade when it changes.
      let shown = -1, swap = 0;
      const label = () => {
        const i = current();
        if (i === shown) return;
        shown = i;
        unflip();
        caption.classList.add('changing');
        clearTimeout(swap);
        swap = window.setTimeout(() => {
          caption.querySelector('b')!.textContent = items[i].dataset.title!;
          caption.querySelector('span')!.textContent = items[i].dataset.subtitle!;
          caption.classList.remove('changing');
        }, 140);
      };

      // Without scroll-driven animations: the same turn, set from each cover's distance to the middle.
      const turn = () => {
        const s = items[0].querySelector<HTMLElement>('.cover')!.offsetWidth, step = items[0].offsetWidth, m = middle();
        for (const li of items) {
          const t = Math.max(-1, Math.min(1, (centreOf(li) - m) / step));       // +1: a step right, -1: a step left
          const a = Math.abs(t), side = Math.sign(t);
          li.querySelector<HTMLElement>('.cover')!.style.transform =
            `translateX(${side * a * s * .44}px) translateZ(${(.04 - a * .44) * s}px) rotateY(${-side * a * 70}deg)`;
        }
      };

      let frame = 0;
      scroller.addEventListener('scroll', () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => { label(); if (!native) turn(); });
      }, { passive: true, signal });

      // A vertical wheel moves one cover at a time.
      let wheelLock = 0;
      scroller.addEventListener('wheel', e => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;           // a trackpad swiping sideways already scrolls
        e.preventDefault();
        if (performance.now() < wheelLock) return;
        wheelLock = performance.now() + 140;
        go(current() + Math.sign(e.deltaY));
      }, { passive: false, signal });

      // Dragging with the mouse, snapping again on release.
      let drag: { x: number; left: number; moved: boolean } | null = null;
      scroller.addEventListener('pointerdown', e => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        drag = { x: e.clientX, left: scroller.scrollLeft, moved: false };
      });
      addEventListener('pointermove', e => {
        if (!drag) return;
        const dx = e.clientX - drag.x;
        if (!drag.moved && Math.abs(dx) < 4) return;
        drag.moved = true;
        scroller.classList.add('dragging');
        scroller.scrollLeft = drag.left - dx;
      }, { signal });
      addEventListener('pointerup', () => {
        if (!drag) return;
        const moved = drag.moved;
        drag = null;
        if (moved) { scroller.classList.remove('dragging'); go(current()); scroller.dataset.dragged = '1'; }
      }, { signal });

      // A click on a cover at the side brings it to the middle; on the middle one, it turns it over.
      scroller.addEventListener('click', e => {
        if (scroller.dataset.dragged) { delete scroller.dataset.dragged; e.preventDefault(); return; }
        const t = e.target as Element, li = t.closest('li') as HTMLLIElement | null;
        if (!li) return;
        const i = items.indexOf(li);
        if (i !== current()) { e.preventDefault(); unflip(); go(i); return; }
        const keyboard = (e as MouseEvent).detail === 0;
        const listen = t.closest<HTMLButtonElement>('.listen');
        // Going to the song's page: its back travels there and becomes its cover (a view transition).
        if (t.closest('.more') && li.dataset.song) li.querySelector<HTMLElement>('.back')!.style.viewTransitionName = `portada-${+li.dataset.song + 1}`;
        if (t.closest('.front')) flip(li, true, keyboard);
        else if (t.closest('.turn')) flip(li, false, keyboard);
        else if (listen) {
          if (nowPlaying()?.src === listen.dataset.src && !player.paused) player.pause();
          else playTrack(listen.dataset.src!, listen.dataset.title!);
        }
      });

      // The backs' play buttons follow the one player (the intro's iPhone plays through it too).
      const listens = [...scroller.querySelectorAll<HTMLButtonElement>('.listen')];
      const syncListen = () => listens.forEach(b => {
        const on = !player.paused && nowPlaying()?.src === b.dataset.src;
        b.classList.toggle('on', on);
        b.querySelector('span')!.textContent = on ? 'Pausa' : 'Escuchar';
      });
      player.addEventListener('play', syncListen, { signal });
      player.addEventListener('pause', syncListen, { signal });
      addEventListener('yeyo:track', syncListen, { signal });
      syncListen();

      // Arrow keys step through the covers.
      scroller.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); go(current() + (e.key === 'ArrowRight' ? 1 : -1)); }
        if (e.key === 'Escape') { const li = items.find(l => l.classList.contains('flipped')); if (li) flip(li, false, true); }
      });

      // Open on the starting cover; again once the page has loaded, since a reload restores the old
      // scroll position over it.
      const begin = () => { go(Number(scroller.dataset.start) || 0, false); if (!native) turn(); shown = current(); };
      begin();
      if (document.readyState !== 'complete') addEventListener('load', begin, { once: true, signal });
      addEventListener('resize', () => { go(shown, false); if (!native) turn(); }, { signal });
    }
  });
</script>
