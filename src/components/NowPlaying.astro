---
// What is playing, top left under the status bar, on every page but the iPod (Música), which has its own
// controls: a pause/play button, and the song's title with three bars moving to it, which opens the
// iPod. It shows up once something plays (from the iPhone in the intro, the back of a cover, the iPod)
// and stays put from page to page while the song goes on.
---

<div class="now-playing" transition:persist="now-playing" hidden>
  <button class="np-pp" type="button" aria-label="Pausar la música">
    <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>
    <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4.5h3.6v15H6.5zM13.9 4.5h3.6v15h-3.6z" /></svg>
  </button>
  <a class="np-open" href="/musica" aria-label="Abrir el iPod">
    <span class="np-eq" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="np-title"></span>
  </a>
</div>

<style>
  .now-playing {
    position: fixed; top: calc(var(--sbh) + 10px); left: 12px; z-index: 40; display: flex; align-items: center;
    max-width: min(320px, calc(100vw - 24px)); height: 30px; padding: 0 12px 0 3px; border-radius: 15px; color: #fff;
    background: linear-gradient(rgba(70, 70, 70, .82), rgba(10, 10, 10, .86));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28), 0 0 0 .5px rgba(0, 0, 0, .5), 0 6px 16px rgba(0, 0, 0, .18);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font: 700 12px/1 'Helvetica Neue', Helvetica, Arial, sans-serif; text-shadow: 0 -1px 0 rgba(0, 0, 0, .5);
    view-transition-name: now-playing;
  }
  .now-playing[hidden], :global(html[data-intro]) .now-playing, :global(body[data-page='musica']) .now-playing { display: none; }
  .np-pp { display: grid; place-items: center; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 50%; background: none; color: inherit; cursor: pointer; }
  .np-pp svg { width: 13px; height: 13px; fill: currentColor; filter: drop-shadow(0 -1px 0 rgba(0, 0, 0, .5)); }
  .np-pp .play, .now-playing.paused .np-pp .pause { display: none; }
  .now-playing.paused .np-pp .play { display: block; }
  .np-open { display: flex; align-items: center; gap: 8px; min-width: 0; padding-left: 4px; color: inherit; }
  .np-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .np-eq { display: inline-flex; flex: none; gap: 2px; align-items: end; height: 10px; }
  .np-eq i { width: 2.5px; height: 100%; background: currentColor; transform-origin: bottom; scale: 1 .35; }
  .now-playing.paused .np-title { opacity: .6; }
  .np-pp:focus-visible, .np-open:focus-visible { outline: 2px solid #7fb0f5; outline-offset: 1px; border-radius: 12px; }
  @media (prefers-reduced-motion: no-preference) {
    .now-playing:not(.paused) .np-eq i { animation: bar .8s ease-in-out infinite alternate; }
    .now-playing:not(.paused) .np-eq i:nth-child(2) { animation-duration: .55s; }
    .now-playing:not(.paused) .np-eq i:nth-child(3) { animation-duration: .7s; }
  }
  @keyframes bar { from { scale: 1 .25; } to { scale: 1 1; } }
</style>

<script>
  import { player, toggle, nowPlaying, type Track } from '../scripts/player';

  const chip = document.querySelector<HTMLElement>('.now-playing')!;
  const pp = chip.querySelector<HTMLButtonElement>('.np-pp')!, name = chip.querySelector('.np-title')!;
  const sync = () => {
    chip.classList.toggle('paused', player.paused);
    pp.setAttribute('aria-label', player.paused ? `Seguir escuchando ${nowPlaying()?.title ?? ''}` : 'Pausar la música');
  };
  addEventListener('yeyo:track', e => { name.textContent = (e as CustomEvent<Track>).detail.title; });
  player.addEventListener('play', () => { chip.hidden = false; sync(); });
  player.addEventListener('pause', sync);
  pp.addEventListener('click', toggle);
</script>
