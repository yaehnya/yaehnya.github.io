---
// Once a visit, an iOS 4 push notification, with Apple's own alert artwork and the Tri-tone: the app's
// name, the news, and two buttons. Here the news is the latest song, and "Escuchar" plays it. It waits
// until the visitor has been on the site a few seconds (and is past the intro), stays out of the iPod's
// way (Música already plays it), and never comes back in the same visit.
import { site } from '../data/site';
const song = site.songs.find(s => s.audio);
---

{song && (
  <div class="notice" role="alertdialog" aria-labelledby="notice-t" aria-describedby="notice-d" hidden data-src={song.audio} data-title={song.title}>
    <div class="n-box">
      <p class="n-app" id="notice-t">{site.name}</p>
      <p class="n-text" id="notice-d">Nuevo sencillo: «{song.title}». Ya está aquí.</p>
      <div class="n-buttons">
        <button type="button" data-n="close">Cerrar</button>
        <button type="button" data-n="play">Escuchar</button>
      </div>
    </div>
  </div>
)}

<style>
  /* Apple's own alert: the navy glass panel and its buttons (UIKit's artwork, stretched by its edges),
     over the screen dimmed with iOS's spotlight. */
  .notice { position: absolute; inset: 0; z-index: 160; display: grid; place-items: center; background: url('/ios/ui/UIAlertViewDimmingSpotlight.png') center / 100% 100%; }
  .notice[hidden] { display: none; }
  .n-box {
    width: 284px; padding: 16px 16px 16px; color: #fff; text-align: center;
    border: 0 solid; border-image: url('/ios/ui/UIPopupAlertSheetBackground.png') 60 30 50 30 fill / 30px 15px 25px 15px;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, .45));
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; text-transform: none; letter-spacing: 0; text-shadow: 0 -1px 0 rgba(0, 0, 0, .55);
  }
  .n-app { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
  .n-text { margin: 0 0 12px; font-size: 15px; line-height: 19px; }
  .n-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .n-buttons button {
    height: 43px; padding: 0 6px; color: #fff; cursor: pointer; background: none;
    border: 0 solid; border-image: url('/ios/ui/UIPopupAlertSheetButton.png') 0 10 fill / 0 5px;
    font: 700 17px/43px 'Helvetica Neue', Helvetica, Arial, sans-serif; text-shadow: 0 -1px 0 rgba(0, 0, 0, .55);
  }
  .n-buttons [data-n='play'] { border-image-source: url('/ios/ui/UIPopupAlertSheetDefaultButton.png'); }
  .n-buttons button:active { border-image-source: url('/ios/ui/UIPopupAlertSheetButtonPress.png'); }
  .n-buttons button:focus-visible { outline: 2px solid #fff; outline-offset: 1px; }
  /* As iOS's alerts came: a little small, a little too big, then settled; the dimming fades in. */
  @media (prefers-reduced-motion: no-preference) {
    .notice.in { animation: dim-in .2s ease-out both; }
    .notice.in .n-box { animation: alert-in .4s ease-out both; }
    .notice.out { animation: dim-in .2s ease-in reverse both; }
  }
  @keyframes dim-in { from { opacity: 0; } }
  @keyframes alert-in { 0% { scale: .6; opacity: 0; } 45% { scale: 1.08; opacity: 1; } 75% { scale: .97; } 100% { scale: 1; } }
</style>

<script>
  import { onPage } from '../scripts/page';
  import { tritone, vibrate } from '../scripts/sounds';
  import { player, playTrack } from '../scripts/player';

  const KEY = 'yeyo-aviso';
  const seen = () => { try { return !!sessionStorage.getItem(KEY); } catch { return true; } };
  let timer = 0;

  onPage(signal => {
    const box = document.querySelector<HTMLElement>('.notice');
    clearTimeout(timer);
    if (!box || seen()) return;
    const close = () => {
      if (box.hidden) return;
      box.classList.replace('in', 'out');
      setTimeout(() => { box.hidden = true; box.classList.remove('out'); }, 200);
    };
    const show = () => {
      const html = document.documentElement;
      // Not over the intro, the springboard or the iPod, and not while something already plays.
      if (html.hasAttribute('data-intro') || html.classList.contains('sb-open') || document.body.dataset.page === 'musica' || !player.paused) {
        timer = window.setTimeout(show, 4000);
        return;
      }
      try { sessionStorage.setItem(KEY, '1'); } catch {}
      box.hidden = false;
      box.classList.add('in');
      tritone();
      vibrate(30);
      box.querySelector<HTMLElement>('[data-n="play"]')?.focus({ preventScroll: true });
    };
    timer = window.setTimeout(show, 9000);
    signal.addEventListener('abort', () => clearTimeout(timer));
    box.addEventListener('click', e => {
      const b = (e.target as Element).closest<HTMLElement>('[data-n]');
      if (!b) return;
      if (b.dataset.n === 'play') playTrack(box.dataset.src!, box.dataset.title!);
      close();
    }, { signal });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); }, { signal });
  });
</script>
