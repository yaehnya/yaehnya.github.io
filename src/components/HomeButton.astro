---
// The home button is the photo's own: a round, invisible button laid over it (measured on the photo:
// centred, 91.4% down, 18% of the phone's width across), which goes in a little when pressed. As on
// iOS 4: one press goes home, to the springboard (Springboard.astro), and from there back into the
// app; two quick presses bring up the multitasking bar with the iPod's controls (Switcher.astro). On
// the game's page, which has no springboard, it goes back to the site.
---

<button class="home-btn" type="button" aria-label="Botón de inicio (dos veces: controles de la música)" aria-expanded="false" aria-controls="springboard">
  <span aria-hidden="true"></span>
</button>

<style>
  .home-btn {
    position: absolute; left: 91.4%; top: 50%; z-index: 3; width: calc(var(--dh) * .18); height: calc(var(--dh) * .18);
    translate: -50% -50%; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  @media (orientation: portrait) {
    .home-btn { left: 50%; top: 91.4%; width: calc(var(--dw) * .18); height: calc(var(--dw) * .18); }
  }
  /* Pressed: the button goes in, its bowl in shadow. */
  .home-btn span { position: absolute; inset: 6%; border-radius: 50%; transition: box-shadow 80ms, background-color 80ms; }
  .home-btn:active span { background: rgba(0, 0, 0, .06); box-shadow: inset 0 3px 7px rgba(0, 0, 0, .28); }
  .home-btn:focus-visible { outline: 2px solid #3a76d8; outline-offset: 2px; }
  :global(html[data-intro]) .home-btn, :global(html.bw-on) .home-btn { display: none; }
</style>

<script>
  import { vibrate } from '../scripts/sounds';

  const btn = document.querySelector<HTMLButtonElement>('.home-btn')!;
  let wait = 0;
  btn.addEventListener('click', () => {
    vibrate(10);
    if (!document.getElementById('springboard')) { location.assign('/'); return; }
    if (wait) {                                     // the second press: the multitasking bar
      clearTimeout(wait); wait = 0;
      document.dispatchEvent(new CustomEvent('yeyo:home2'));
      return;
    }
    wait = window.setTimeout(() => { wait = 0; document.dispatchEvent(new CustomEvent('yeyo:home')); }, 260);
  });
  // The H key presses it too.
  addEventListener('keydown', e => {
    if (e.key.toLowerCase() === 'h' && !(e.target as Element).closest('input, textarea, [contenteditable]')) btn.click();
  });
</script>
