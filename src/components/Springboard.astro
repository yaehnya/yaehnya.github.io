---
// The menu is iOS 4's home screen, the springboard, on the iPhone's screen: the site's sections as
// apps with Apple's own icons (public/ios/iconos/), the page dots, and the dock with Spotify, YouTube
// and Instagram as their iPhone icons looked in 2010, and iTunes. The wallpaper is the cover of the
// song playing (or site.wallpaper), with iOS's own shading top and bottom.
//
// It moves as iOS 4 did. The home button: the app shrinks away into the middle of the screen while the
// icons come in from beyond the edges. An app: it grows out of the middle while the icons fly off (the
// page change itself, a View Transition: scripts/transitions.ts and global.css). The home button again
// goes back into the app. Holding an icon makes them all jiggle; the home button stops it. Ajustes is
// an app inside: the sounds and the vibration, with iOS 4's SÍ/NO switches, and the intro once more.
import { site, type Page } from '../data/site';

interface Props { page: Page }
const { page } = Astro.props;

const apps: { id: string; icon: string; href: string; label: string; page?: Page; reload?: boolean; settings?: boolean }[] = [
  { id: 'coverflow', icon: 'fotos', href: '/', label: 'Fotos', page: 'home' },
  { id: 'musica', icon: 'ipod', href: '/musica', label: 'iPod', page: 'musica' },
  { id: 'fechas', icon: 'calendario', href: '/fechas', label: 'Calendario', page: 'fechas' },
  { id: 'tienda', icon: 'app-store', href: '/tienda', label: 'App Store', page: 'tienda' },
  { id: 'contacto', icon: 'mensajes', href: '/contacto', label: 'Mensajes', page: 'contacto' },
  { id: 'juego', icon: 'safari', href: '/juego', label: 'Safari', page: 'juego', reload: true },   // the game: Wikipedia, in Safari
  { id: 'ajustes', icon: 'ajustes', href: '#ajustes', label: 'Ajustes', settings: true },
];
const dock = [
  { id: 'spotify', label: 'Spotify', href: site.social.spotify },
  { id: 'youtube', label: 'YouTube', href: site.social.youtube },
  { id: 'instagram', label: 'Instagram', href: site.social.instagram },
  { id: 'itunes', label: 'iTunes', href: site.social.apple },
];

// The calendar icon shows the day, as iOS's did; the script sets today's, this is the build's.
const now = new Date();
const weekday = now.toLocaleDateString('es-MX', { weekday: 'long' });
// While a song plays, its cover is the wallpaper.
const covers = Object.fromEntries(site.songs.filter(s => s.audio).map(s => [s.audio, s.image]));
---

<div id="springboard" class="springboard" role="dialog" aria-modal="true" aria-label="Inicio: las apps" hidden
  data-lenis-prevent data-wall={site.wallpaper.src} data-covers={JSON.stringify(covers)}>
  <div class="bg" aria-hidden="true">
    <img class="wall" src={site.wallpaper.src} alt="" width="1000" height="1000" loading="lazy" decoding="async" />
  </div>

  <div class="layer">
    <ul class="grid">
      {apps.map(a => (
        <li>
          <a class="app" href={a.href} data-app={a.id} aria-current={page === a.page ? 'page' : undefined}
            data-astro-reload={a.reload ? '' : undefined} data-settings={a.settings ? '' : undefined}>
            <span class="icon" aria-hidden="true">
              <img src={`/ios/iconos/${a.icon}.png`} alt="" width="57" height="57" draggable="false" />
              {a.id === 'fechas' && <><b class="wd">{weekday}</b><b class="day">{now.getDate()}</b></>}
            </span>
            <span class="name">{a.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="dots" aria-hidden="true"><i class="spot"></i><i class="on"></i></p>

    <nav class="dock" aria-label={`${site.name} en`}>
      <ul>
        {dock.map(d => (
          <li>
            <a class="app" href={d.href} target="_blank" rel="noopener" data-app={d.id}>
              <span class="icon" aria-hidden="true"><img src={`/ios/iconos/${d.id}.png`} alt="" width="57" height="57" draggable="false" /></span>
              <span class="name">{d.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Ajustes: iOS 4's grouped table on its pinstripes. -->
  <section class="settings" aria-label="Ajustes" hidden>
    <header class="navbar"><b>Ajustes</b></header>
    <div class="table">
      <ul class="group">
        <li>
          <span class="row-name" id="aj-sonidos">Sonidos</span>
          <label class="switch">
            <input type="checkbox" role="switch" data-set="sonidos" aria-labelledby="aj-sonidos" />
            <span class="track" aria-hidden="true"><span class="on">SÍ</span><span class="knob"></span><span class="off">NO</span></span>
          </label>
        </li>
        <li data-if-vibrate>
          <span class="row-name" id="aj-vibrar">Vibración</span>
          <label class="switch">
            <input type="checkbox" role="switch" data-set="vibrar" aria-labelledby="aj-vibrar" />
            <span class="track" aria-hidden="true"><span class="on">SÍ</span><span class="knob"></span><span class="off">NO</span></span>
          </label>
        </li>
      </ul>
      <ul class="group">
        <li><button class="row-btn" type="button" data-set="intro">Ver la intro otra vez <span aria-hidden="true">›</span></button></li>
      </ul>
    </div>
  </section>
</div>

<style>
  /* Measured in the iPhone's points (the display is 480 × 320, or 320 × 480 upright). */
  .springboard {
    position: absolute; inset: 0; z-index: 150; overflow: hidden; color: #fff; background: #000;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; text-transform: none; letter-spacing: 0;
    -webkit-user-select: none; user-select: none;
  }
  .bg { position: absolute; inset: 0; }
  .wall { width: 100%; height: 100%; max-width: none; object-fit: cover; }
  /* iOS's own shading of the wallpaper, under the status bar and behind the dock. */
  .bg::before, .bg::after { content: ''; position: absolute; left: 0; right: 0; background-size: 100% 100%; }
  .bg::before { top: 0; height: 62px; background-image: url('/ios/ui/WallpaperGradientPortraitTop.png'); }
  .bg::after { bottom: 0; height: 237px; background-image: url('/ios/ui/WallpaperGradientPortraitBottom.png'); }

  /* Everything that flies: the icons, the dots, the dock. */
  .layer { position: absolute; inset: var(--sbh) 0 0; view-transition-name: sb-icons; }

  .grid {
    display: grid; grid-template-columns: repeat(6, 76px); justify-content: center; row-gap: 12px;
    margin: 8px 0 0; padding: 0; list-style: none;
  }
  .app { display: grid; justify-items: center; gap: 3px; width: 76px; color: #fff; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
  .name {
    max-width: 74px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    font-size: 11px; font-weight: 700; line-height: 13px; text-shadow: 0 1px 1px rgba(0, 0, 0, .9);
  }
  .app:focus-visible { outline: none; }
  .app:focus-visible .icon img { outline: 2px solid #fff; outline-offset: 2px; border-radius: 10px; }

  /* An icon: Apple's artwork (gloss and all), on iOS's own soft shadow. Pressed, it darkens. */
  .icon { position: relative; display: block; width: 57px; height: 57px; }
  .icon::before {
    content: ''; position: absolute; left: 50%; top: 50%; width: 103px; height: 103px; translate: -50% -47%;
    background: url('/ios/ui/WallpaperIconShadow.png') center / 100% no-repeat; pointer-events: none;
  }
  .icon img { position: relative; width: 57px; height: 57px; max-width: none; }
  .app:active .icon img { filter: brightness(.5); }
  /* The calendar: the day of the week on its red band, the date big, as iOS wrote them on the icon. */
  .wd, .day { position: absolute; left: 0; right: 0; text-align: center; }
  .wd { top: 1px; color: #fff; font-size: 8.5px; line-height: 13px; text-transform: capitalize; text-shadow: 0 -1px 0 rgba(0, 0, 0, .4); }
  .day { top: 14px; color: #2a2a2a; font-size: 31px; line-height: 40px; letter-spacing: -1.5px; text-shadow: 0 1px 0 #fff; }

  /* The page dots, Spotlight's magnifier first. */
  .dots { position: absolute; left: 0; right: 0; bottom: 92px; display: flex; justify-content: center; gap: 10px; margin: 0; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, .35); }
  .dots .on { background: #fff; }
  .dots .spot { width: 10px; height: 10px; margin-top: -1.5px; background: url('/ios/ui/SBSearchPageIndicator.png') center / 100% no-repeat; }

  /* The dock: iOS's glass shelf, the icons standing on it and mirrored in it, their names on its edge. */
  .dock { position: absolute; left: 0; right: 0; bottom: 0; height: 90px; background: url('/ios/ui/SBDockBG.png') bottom / 100% 45px no-repeat; }
  .dock ul { display: grid; grid-template-columns: repeat(4, 76px); justify-content: space-evenly; margin: 0; padding: 0 20px; list-style: none; }
  .dock .app { gap: 4px; padding-top: 11px; }
  .dock .icon::before { width: 59px; height: 60px; translate: -50% -50%; background-image: url('/ios/ui/WallpaperIconDockShadow.png'); }
  .dock .icon img { -webkit-box-reflect: below 3px linear-gradient(transparent 70%, rgba(255, 255, 255, .25)); }

  @container display (orientation: portrait) {
    .grid { grid-template-columns: repeat(4, 76px); row-gap: 18px; margin-top: 10px; }
    .dots { bottom: 100px; }
  }

  /* Holding an icon: they all jiggle, each a little out of step. */
  @media (prefers-reduced-motion: no-preference) {
    .springboard.jiggle .icon { animation: jiggle .24s ease-in-out infinite alternate; }
    .springboard.jiggle li:nth-child(2n) .icon { animation-delay: -.12s; animation-duration: .27s; }
    .springboard.jiggle li:nth-child(3n) .icon { animation-delay: -.07s; animation-duration: .22s; }
  }
  @keyframes jiggle { from { rotate: -2.4deg; } to { rotate: 2.4deg; } }

  /* Ajustes: Apple's bar and pinstripes. */
  .settings {
    position: absolute; inset: var(--sbh) 0 0; z-index: 5; display: grid; grid-template-rows: 44px 1fr; color: #000;
    background: url('/ios/ui/UIPinstripe.png') 0 0 / 512px 1px;
  }
  .navbar {
    display: grid; place-items: center; color: #fff; font-size: 20px; text-shadow: 0 -1px 0 rgba(0, 0, 0, .45);
    background: url('/ios/ui/UINavigationBarDefaultBackground.png') 0 0 / 100% 44px;
  }
  .table { overflow-y: auto; padding: 10px 10px 20px; }
  .group {
    max-width: 460px; margin: 0 auto 18px; padding: 0; list-style: none; overflow: hidden;
    background: #fff; border: 1px solid #a8acb2; border-radius: 9px; box-shadow: 0 1px 0 rgba(255, 255, 255, .8);
  }
  .group li { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 10px; border-top: 1px solid #dcdcdc; font-size: 17px; font-weight: 700; }
  .group li:first-child { border-top: 0; }
  .row-btn {
    display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 44px; padding: 0; border: 0; background: none;
    color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .row-btn span { color: #8e8e93; font-size: 22px; font-weight: 400; }

  /* iOS 4's switch, in Spanish: SÍ in blue, NO in grey, a silver knob sliding between them. */
  .switch {
    position: relative; flex: none; margin-left: auto; width: 94px; height: 27px; overflow: hidden; border-radius: 5px; cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .35);
  }
  .switch input { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .track { position: absolute; top: 0; bottom: 0; left: 0; display: flex; width: 148px; transition: translate .18s ease-out; }
  .track > span:not(.knob) { width: 54px; font-size: 16px; font-weight: 700; line-height: 27px; text-align: center; box-shadow: inset 0 2px 3px rgba(0, 0, 0, .28); }
  .track .on { background: linear-gradient(#1e62d6, #3a86f2 50%, #5aa1f6); color: #fff; text-shadow: 0 -1px 0 rgba(0, 0, 0, .35); padding-left: 4px; }
  .track .off { background: linear-gradient(#e3e3e3, #fcfcfc); color: #7d7d7d; padding-right: 4px; }
  .knob {
    position: relative; z-index: 1; flex: none; width: 40px; border-radius: 5px;
    background: linear-gradient(#fff, #ececec 50%, #d6d6d6 51%, #f3f3f3);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .4), 0 1px 2px rgba(0, 0, 0, .3), inset 0 1px 0 #fff;
  }
  .switch input:not(:checked) + .track { translate: -54px 0; }
  .switch input:focus-visible + .track { outline: 2px solid #3a76d8; outline-offset: -2px; }
</style>

<script>
  import { onPage } from '../scripts/page';
  import { launch, scroller } from '../scripts/transitions';
  import { nowPlaying } from '../scripts/player';
  import { vibrate, setSound, setVibration, soundOn, vibrationOn } from '../scripts/sounds';

  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const out = 'cubic-bezier(.2, .7, .3, 1)';         // arrives and settles
  const away = 'cubic-bezier(.5, 0, .75, .3)';        // leaves, gathering speed
  const done = (anims: Animation[]) => Promise.all(anims.map(a => a.finished.catch(() => {})));

  onPage(signal => {
    const sb = document.getElementById('springboard');
    if (!sb) return;
    const root = document.documentElement;
    const page = scroller()!;
    const homeBtn = document.querySelector<HTMLButtonElement>('.home-btn');
    const wall = sb.querySelector<HTMLImageElement>('.wall')!;
    const icons = [...sb.querySelectorAll<HTMLElement>('.grid li, .dock li')];
    const dots = sb.querySelector<HTMLElement>('.dots')!;
    const settings = sb.querySelector<HTMLElement>('.settings')!;
    const covers: Record<string, string> = JSON.parse(sb.dataset.covers || '{}');
    let open = false, busy = false, held = false;

    // Today on the calendar icon.
    const today = new Date();
    sb.querySelector('.wd')!.textContent = today.toLocaleDateString('es-MX', { weekday: 'long' });
    sb.querySelector('.day')!.textContent = String(today.getDate());
    (window.requestIdleCallback ?? setTimeout)(() => { wall.loading = 'eager'; });

    // Where an icon comes in from, and flies off to: outward from the middle of the screen, bigger.
    // (Measured on screen, then brought back to the display's points: the display is zoomed.)
    const outward = (el: HTMLElement) => {
      const r = el.getBoundingClientRect(), s = sb.getBoundingClientRect(), k = s.width / sb.offsetWidth;
      const x = (r.left + r.width / 2 - s.left) / k - sb.offsetWidth / 2;
      const y = (r.top + r.height / 2 - s.top) / k - sb.offsetHeight / 2;
      return `translate(${x * 1.1}px, ${y * 1.1}px) scale(2.2)`;
    };
    const fly = (inwards: boolean) => icons.map(li => li.animate(
      inwards ? [{ transform: outward(li), opacity: 0 }, { transform: 'none', opacity: 1 }] : [{ transform: 'none', opacity: 1 }, { transform: outward(li), opacity: 0 }],
      { duration: inwards ? 480 : 380, easing: inwards ? out : away, fill: inwards ? 'backwards' : 'forwards' }));

    // The home button, in an app: the app shrinks into the middle and fades; the icons come in.
    let shrunk: Animation | null = null;
    const show = async () => {
      if (open || busy) return;
      open = busy = true;
      const t = nowPlaying();
      wall.src = (t && covers[t.src]) || sb.dataset.wall!;
      sb.hidden = false;
      root.classList.add('sb-open');
      homeBtn?.setAttribute('aria-expanded', 'true');
      page.inert = true;
      if (!still.matches) {
        page.style.zIndex = '151';
        shrunk = page.animate([{ transform: 'none', opacity: 1 }, { transform: 'scale(.15)', opacity: 0 }], { duration: 420, easing: 'cubic-bezier(.4, 0, .6, 1)', fill: 'forwards' });
        await done([shrunk, ...fly(true), dots.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 200, fill: 'backwards' })]);
      }
      page.style.visibility = 'hidden';
      page.style.zIndex = '';
      busy = false;
      sb.querySelector<HTMLElement>('.grid .app')?.focus({ preventScroll: true });
    };

    // Back into the app: it grows out of the middle; the icons fly off.
    const hide = async () => {
      if (!open || busy) return;
      busy = true;
      sb.classList.remove('jiggle');
      page.style.visibility = '';
      if (!still.matches) {
        page.style.zIndex = '151';
        shrunk?.cancel();
        const gone = fly(false);
        await done([page.animate([{ transform: 'scale(.1)', opacity: 0 }, { opacity: 1, offset: .3 }, { transform: 'none', opacity: 1 }], { duration: 420, easing: out }), ...gone]);
        gone.forEach(a => a.cancel());
      }
      page.style.zIndex = '';
      sb.hidden = true;
      settings.hidden = true;
      root.classList.remove('sb-open');
      page.inert = false;
      homeBtn?.setAttribute('aria-expanded', 'false');
      open = busy = false;
    };

    // ---- Ajustes, an app inside the springboard: it opens the way an app does ----
    let flown: Animation[] = [];
    const openSettings = async () => {
      if (busy) return;
      busy = true;
      settings.hidden = false;
      if (!still.matches) {
        flown = fly(false);
        await done([settings.animate([{ transform: 'scale(.1)', opacity: 0 }, { opacity: 1, offset: .3 }, { transform: 'none', opacity: 1 }], { duration: 420, easing: out }), ...flown]);
      }
      busy = false;
      settings.querySelector<HTMLElement>('input, button')?.focus({ preventScroll: true });
    };
    const closeSettings = async () => {
      if (busy) return;
      busy = true;
      if (!still.matches) {
        flown.forEach(a => a.cancel());
        await done([settings.animate([{ transform: 'none', opacity: 1 }, { transform: 'scale(.15)', opacity: 0 }], { duration: 420, easing: 'cubic-bezier(.4, 0, .6, 1)' }), ...fly(true)]);
      }
      settings.hidden = true;
      busy = false;
      sb.querySelector<HTMLElement>('[data-settings]')?.focus({ preventScroll: true });
    };

    const sound = settings.querySelector<HTMLInputElement>('[data-set="sonidos"]')!;
    const buzz = settings.querySelector<HTMLInputElement>('[data-set="vibrar"]')!;
    sound.checked = soundOn();
    buzz.checked = vibrationOn();
    if (!('vibrate' in navigator)) settings.querySelector<HTMLElement>('[data-if-vibrate]')!.hidden = true;
    sound.addEventListener('change', () => setSound(sound.checked), { signal });
    buzz.addEventListener('change', () => { setVibration(buzz.checked); vibrate(30); }, { signal });
    settings.querySelector('[data-set="intro"]')!.addEventListener('click', () => {
      try { sessionStorage.removeItem('yeyo-intro'); } catch {}
      location.href = '/';
    }, { signal });

    // ---- Holding an icon: the jiggle ----
    let hold = 0, from: [number, number] = [0, 0];
    sb.addEventListener('pointerdown', e => {
      if (!(e.target as Element).closest('.app') || e.button !== 0) return;
      from = [e.clientX, e.clientY];
      hold = window.setTimeout(() => { sb.classList.add('jiggle'); held = true; vibrate(25); }, 700);
    }, { signal });
    sb.addEventListener('pointermove', e => { if (Math.hypot(e.clientX - from[0], e.clientY - from[1]) > 8) clearTimeout(hold); }, { signal });
    for (const type of ['pointerup', 'pointercancel']) sb.addEventListener(type, () => clearTimeout(hold), { signal });
    sb.addEventListener('contextmenu', e => { if ((e.target as Element).closest('.app')) e.preventDefault(); }, { signal });

    // ---- Opening an app ----
    sb.addEventListener('click', e => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a.app');
      if (held) { held = false; e.preventDefault(); return; }            // the press that started the jiggle
      if (sb.classList.contains('jiggle')) { e.preventDefault(); return; }
      if (!a || a.target === '_blank') return;                             // the dock's: Spotify and the rest, in a new tab
      e.preventDefault();
      if (busy) return;
      if (a.hasAttribute('data-settings')) { openSettings(); return; }
      if (a.getAttribute('aria-current') === 'page') { hide(); return; }
      vibrate(8);
      if (a.hasAttribute('data-astro-reload')) { location.href = a.href; return; }
      launch(a.href);
    }, { signal });

    // Nothing scrolls under the springboard (only Ajustes' table).
    const keep = (e: Event) => { if (!(e.target as Element).closest('.table')) e.preventDefault(); };
    sb.addEventListener('wheel', keep, { passive: false, signal });
    sb.addEventListener('touchmove', keep, { passive: false, signal });

    // The home button, and Esc: out of Ajustes, out of the jiggle, or in and out of the springboard.
    const home = () => {
      if (!settings.hidden) closeSettings();
      else if (sb.classList.contains('jiggle')) sb.classList.remove('jiggle');
      else if (open) hide();
      else show();
    };
    document.addEventListener('yeyo:home', home, { signal });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && open) { e.preventDefault(); home(); } }, { signal });
    signal.addEventListener('abort', () => { root.classList.remove('sb-open'); homeBtn?.setAttribute('aria-expanded', 'false'); });
  });
</script>
